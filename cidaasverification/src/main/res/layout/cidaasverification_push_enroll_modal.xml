<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/cidaasverification_push_modal_horizontal_margin"
    android:paddingEnd="@dimen/cidaasverification_push_modal_horizontal_margin"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="@color/cidaasverification_push_modal_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        app:strokeColor="@color/cidaasverification_push_modal_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- Icon (colors applied from theme in PushEnrollmentController) -->
            <FrameLayout
                android:id="@+id/cidaasverification_push_icon_container"
                android:layout_width="@dimen/cidaasverification_push_modal_icon_size"
                android:layout_height="@dimen/cidaasverification_push_modal_icon_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:elevation="2dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/cidaasverification_push_modal_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/cidaasverification_ic_push_notifications" />
            </FrameLayout>

            <TextView
                android:id="@+id/cidaasverification_push_modal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="28dp"
                android:gravity="center_horizontal"
                android:letterSpacing="0.02"
                android:lineSpacingExtra="2dp"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Enable push verification" />

            <TextView
                android:id="@+id/cidaasverification_push_modal_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_horizontal"
                android:lineSpacingMultiplier="1.15"
                android:textAlignment="center"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp"
                tools:text="Tap accept to finish enrolling this device. You will use push notifications to approve sign-ins." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:background="@color/cidaasverification_push_modal_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cidaasverification_push_modal_accept"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="14dp"
                    tools:text="Accept" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cidaasverification_push_modal_cancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="@android:string/cancel"
                    android:textAllCaps="false"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
